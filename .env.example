# Node.js 24.12.x; only read during first database initialization.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=demo-2026
# Keep writable SQLite database and uploaded files outside release directories.
# DATABASE_PATH=/opt/lumenhaus/data/demo.sqlite
# UPLOAD_DIR=/opt/lumenhaus/public/uploads
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set 1 only behind the trusted Nginx proxy; bind Next to loopback.
TRUST_PROXY=0
# Set 1 when APP_ORIGIN uses HTTPS.
COOKIE_SECURE=0
